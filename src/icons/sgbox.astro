<svg xmlns="http://w3.org" viewBox="0 0 450 140" width="100%" height="100%">
  <defs>
    <!-- Background subtle enhancement -->
    <style>
      .bg-box { fill: #ffffff; }
      .brand-dark { fill: #0d2346; font-family: 'Montserrat', 'Segoe UI', sans-serif; font-weight: 800; }
      .brand-light { fill: #00bfa5; font-family: 'Montserrat', 'Segoe UI', sans-serif; font-weight: 300; }
      .logo-bracket { fill: none; stroke: #00bfa5; stroke-width: 8; stroke-linecap: round; stroke-linejoin: round; }
      .logo-text-s { fill: #0d2346; }
      .logo-text-g { fill: #0d2346; }
    </style>
  </defs>

  <!-- Background Layer -->
  <rect width="450" height="140" rx="10" class="bg-box" />

  <g transform="translate(15, 0)">
    <!-- Icon Graphic -->
    <g transform="translate(15, 20)">
      <!-- Cyber Frame / Bracket -->
      <path d="M 45,10 L 15,10 L 15,90 L 45,90" class="logo-bracket" />
      <path d="M 55,90 L 85,90 L 85,10 L 55,10" class="logo-bracket" />
      
      <!-- 'S' Geometry -->
      <path d="M 48,32 C 48,25 36,24 36,30 C 36,38 48,36 48,46 C 48,53 37,54 33,48" fill="none" stroke="#0d2346" stroke-width="7" stroke-linecap="round"/>
      
      <!-- 'G' Geometry -->
      <path d="M 66,32 C 66,24 54,24 54,35 C 54,46 66,46 66,38 L 60,38" fill="none" stroke="#0d2346" stroke-width="7" stroke-linecap="round"/>
    </g>

    <!-- Typography Section -->
    <g transform="translate(130, 82)">
      <!-- SG Bold Title -->
      <text x="0" y="0" font-size="52" letter-spacing="-1" class="brand-dark">SG</text>
      <!-- Box Sleek Title -->
      <text x="74" y="0" font-size="52" letter-spacing="-0.5" class="brand-light">Box</text>
    </g>
    
    <!-- Platform Subtitle -->
    <g transform="translate(133, 104)">
      <text x="0" y="0" font-size="11" font-family="'Segoe UI', sans-serif" font-weight="600" letter-spacing="4" fill="#a0aec0">SIEM &amp; SOAR PLATFORM</text>
    </g>
  </g>
</svg>
